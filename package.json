{
  "name": "drumpal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "worker:dev": "node ./node_modules/wrangler/bin/wrangler.js dev worker/index.js",
    "worker:deploy": "node ./node_modules/wrangler/bin/wrangler.js deploy worker/index.js",
    "db:migrate": "node ./node_modules/wrangler/bin/wrangler.js d1 execute drumpal-db --file=db/schema.sql",
    "db:migrate:local": "node ./node_modules/wrangler/bin/wrangler.js d1 execute drumpal-db --local --file=db/schema.sql",
    "db:seed": "node scripts/generateLessons.js && node ./node_modules/wrangler/bin/wrangler.js d1 execute drumpal-db --file=db/seed.sql",
    "db:seed:local": "node scripts/generateLessons.js && node ./node_modules/wrangler/bin/wrangler.js d1 execute drumpal-db --local --file=db/seed.sql",
    "generate": "node scripts/generateLessons.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "wrangler": "^3.70.0"
  }
}
